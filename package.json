{
  "name": "sap-mcp-gateway",
  "version": "1.0.0",
  "description": "SAP Intelligence Gateway — MCP server bridging AI models into SAP ERP workflows",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:sse": "tsx src/index.ts --sse",
    "dashboard": "tsx src/dashboard-server.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "sap",
    "erp",
    "ai",
    "model-context-protocol"
  ],
  "author": "Shreyas",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
